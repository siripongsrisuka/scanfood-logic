{
  "name": "@scanfood/logic",
  "version": "0.1.0",
  "description": "Canonical business logic shared across Scanfood repos (loyalty calc · rank · date-math). Single source of truth — import, never redefine (anti-dup gate · contract-layer).",
  "license": "UNLICENSED",
  "main": "./src/index.js",
  "exports": {
    ".": {
      "require": "./src/index.js",
      "import": "./src/index.js",
      "default": "./src/index.js"
    },
    "./date": "./src/date.js",
    "./loyalty": "./src/loyalty.js",
    "./rank": "./src/rank.js"
  },
  "files": [
    "src",
    "manifest.json"
  ],
  "sideEffects": false,
  "scripts": {
    "test": "node test/loyalty.test.js && node test/rank.test.js",
    "build": "tsup src/index.js --format cjs,esm --clean"
  },
  "devDependencies": {
    "tsup": "^8.3.0"
  }
}
